ASPNETCORE_ENVIRONMENT=PreProduction
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=kuvik_ondc;User=root;Password=<SET_SECURELY>;SslMode=Required;
ONDC__FIS12__SubscriberUrl=https://bap.kuvikloans.com
ONDC__FIS12__ApiBaseUrl=https://gateway-or-network-endpoint.example/
ONDC__FIS12__SigningKeyId=<REGISTERED_UNIQUE_KEY_ID>
ONDC__FIS12__SigningPrivateKey=<BASE64_ED25519_SEED_OR_64_BYTE_PRIVATE_KEY>
ONDC__FIS12__EncryptionKey=<BASE64_32_BYTE_KEY>
# Trusted callback key mapping: ONDC__FIS12__TrustedSubscriberKeys__bpp.example.com|key-id=<BASE64_ED25519_PUBLIC_KEY>
# Development-only local end-to-end flow (never enable in a deployed environment):
# ONDC__FIS12__LocalMock__Enabled=true
# ONDC__FIS12__LocalMock__BppUri=https://localhost:7269/mock/ondc/
